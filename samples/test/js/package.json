{
  "name": "wag-test-js",
  "version": "0.1.0",
  "description": "Tests the generated wag JS client",
  "dependencies": {
    "swagger-test": "../../gen-js",
    "swagger-test-unwrapped-fetch": "../../gen-js-unwrapped-fetch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.31",
    "hystrixjs": "^0.2.0",
    "assert": "^2.1.0",
    "express": "^4.19.2",
    "nock": "^14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "mocha": "^3.1.2"
  },
  "scripts": {
    "test": "npm run test:wrapped && npm run test:unwrapped-fetch",
    "test:wrapped": "mocha --require ts-node/register *.{ts,js}",
    "test:unwrapped-fetch": "WAG_UNWRAPPED_FETCH=1 mocha --require ts-node/register *.{ts,js}"
  }
}
